---
<%
@partition_filter = :all
@partition_qos_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/partition_qos.rb'
_partial_path = '/etc/ood/config/apps/dashboard/batch_connect/partials/resource_discovery.erb'
_resource_result = ERB.new(File.read(_partial_path)).result(binding)
%>
cluster: "pax"

bc_dynamic_js: true

attributes:
  ta_qos:
    widget: check_box
    label: "Request priority start"
    cacheable: false
    help: |
      Submits the job with `--qos=interactive` for higher scheduling priority, so it
      starts sooner. Intended for short, small sessions: while the box is checked, the
      resource fields above are automatically capped to the interactive QOS limits and
      a notice below lists them. Leave this box unchecked if your job needs more time
      or resources than those limits allow.
    value: "normal"
    checked_value: "interactive"
    unchecked_value: "normal"
  conda_extensions: "0"

  extra_jupyter_args: ""

<%= generate_partition_field.indent(2) %>
<%= generate_gpu_type_field.indent(2) %>
<%= generate_num_cores_field.indent(2) %>
<%= generate_num_memory_field.indent(2) %>
<%= generate_num_hours_field.indent(2) %>

<%
_course_file = '/cluster/tufts/apps/class/course_list.yml'
%>
<%= File.read(_course_file).rstrip if File.exist?(_course_file) %>
<%
# Read the course -> storage directory map (TSV: column 1 = course value,
# column 2 = storage path). Embed it as a data attribute on the working
# directory field so form.js can auto-fill it based on the selected course.
_storage_map_file = '/cluster/tufts/apps/class/course_storage_map.tsv'
_course_storage_map = {}
if File.exist?(_storage_map_file)
  File.foreach(_storage_map_file) do |line|
    parts = line.strip.split(/\s+/, 2)
    next if parts.length < 2 || parts[0].empty?
    _course_storage_map[parts[0]] = parts[1]
  end
end
%>
  working_directory:
    widget: "text_field"
    label: "Top working directory"
    help: Top working directory for your Jupyter session to access your notebooks and data. Default is your **$HOME**.
    data-course-storage-map: '<%= _course_storage_map.to_json %>'

  mode:
    widget: "radio"
    label: "Jupyter Lab or Notebook?"
    value: "1"
    options:
      - ["Jupyter Lab", "1"]
      - ["Jupyter Notebook", "0"]

  module:
    widget: text_field
    label: "Load supporting modules"
    help: ENTER module name **ONLY**. e.g. for "module load cuda/12.9" in command line, ENTER **cuda/12.9**


form:
  - conda_extensions
  - extra_jupyter_args
  - mode
  - course
  - partition
  - bc_num_hours
  - num_cores
  - num_memory
  - gpu_type
  - working_directory
  - module
  - ta_qos
  - bc_email_on_started
